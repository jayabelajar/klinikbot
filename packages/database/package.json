{
  "name": "@klinikbot/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "prisma generate --watch",
    "build": "prisma generate",
    "lint": "echo \"No lint configured for @klinikbot/database\"",
