{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@klinikbot/types/*": ["packages/types/src/*"],
      "@klinikbot/utils/*": ["packages/utils/src/*"],
      "@klinikbot/config/*": ["packages/config/src/*"],
      "@klinikbot/database/*": ["packages/database/src/*"]
    }
  }
}
